# Canonical site URL (metadata, email links)
SITE_URL=https://www.georgetownhomeservices.com

# Transactional email — Resend (https://resend.com). No self-hosted mail server required.
# Create an API key, verify your domain (or use onboarding@resend.dev for testing only).
RESEND_API_KEY=
# Must be a verified sender, e.g. Georgetown Tips <guides@yourdomain.com>
NEWSLETTER_FROM_EMAIL=

# Optional: inbox for storm inspection lead form POSTs from `/api/contact` (defaults to contact email in site-content).
# CONTACT_FORM_EMAIL=

# Optional: inbox for roof inspection leads from `/api/roof-inspection-lead` (defaults to contact email in site-content).
# ROOF_LEAD_NOTIFY_EMAIL=

# Optional: forward signup JSON to Zapier, Make, etc.
# NEWSLETTER_WEBHOOK_URL=

# Optional: forward site feedback (contact form) JSON to Slack/Zapier — same payload as stored in `data/site-feedback.jsonl`.
# SITE_FEEDBACK_WEBHOOK_URL=

# Optional: hide the extended trades (electrical/landscaping/pest/foundation/cleaning).
# Leave unset to show all categories. Set to "false" to revert to core plumbing/HVAC/roofing only.
# NEXT_PUBLIC_SHOW_EXTENDED_HOME_SERVICES=false

# Google AdSense — set your publisher ID (ca-pub-XXXXXXXXXXXXXXXX from AdSense → Account → Publisher ID).
# Then create Display ad units (Ads → By ad unit) and paste numeric slot IDs below.
# NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX
# Optional: one slot for all placements, or split by placement:
# NEXT_PUBLIC_ADSENSE_SLOT=
# NEXT_PUBLIC_ADSENSE_SLOT_INLINE=
# NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
# NEXT_PUBLIC_ADSENSE_SLOT_BEST_OF=
# NEXT_PUBLIC_ADSENSE_SLOT_SERVICE=
# Legacy alias (still supported if PUBLISHER_ID unset):
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-2692091044925789

# Google Analytics 4 — Measurement ID from Admin → Data Streams (G-XXXXXXXXXX).
# Defaults to the site’s live stream in `app/layout.tsx` if unset; override per environment as needed.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-4KH0ZSXVCP

# Google Search Console domain or URL-prefix verification.
# From Search Console choose "HTML tag" verification and paste the content
# value (the "google-site-verification" token only, not the full meta tag).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification token (same approach — paste only the
# content value of the <meta name="msvalidate.01"> tag).
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# impact.com / AppImpact — Media Properties → Website → “Paste meta tag code”.
# Paste only the content value of <meta name="impact-site-verification" content="…" />.
# IMPACT_SITE_VERIFICATION=

# impact.com Publisher Tag — Content → Ad Tools → Publisher Tag → Copy Tag. Verification via
# “Paste tracking script code” expects this in <head> (full <script>…</script> or JS body only).
# Use Vercel / dashboard multiline env; local .env.local may need quoting for special chars.
# IMPACT_PUBLISHER_TAG=

# Optional: comma-separated absolute URLs for Person JSON-LD `sameAs` (e.g. LinkedIn).
# NEXT_PUBLIC_AUTHOR_SAME_AS=

# Optional: Organization JSON-LD `sameAs` in root layout (Google Business Profile, Facebook, etc.).
# NEXT_PUBLIC_GOOGLE_BUSINESS_PROFILE_URL=https://maps.google.com/?cid=...
# NEXT_PUBLIC_FACEBOOK_PAGE_URL=https://www.facebook.com/...

# Featured listing subscriptions — Stripe Payment Link URL (Advertise page checkout button).
# NEXT_PUBLIC_FEATURED_STRIPE_URL=https://buy.stripe.com/...

# --- IndexNow (Bing, etc.) — https://www.indexnow.org/documentation ---
# Generate any GUID (e.g. https://www.uuidgenerator.net/). Must match the verification file
# `https://YOUR_HOST/<KEY>.txt` (created at build time from `scripts/write-indexnow-key.cjs`).
# INDEXNOW_KEY=a1b2c3d4-e5f6-7890-abcd-ef1234567890
#
# Optional: protect POST /api/indexnow — send header `Authorization: Bearer <secret>`.
# INDEXNOW_SUBMIT_SECRET=
#
# Optional: one-off script `npm run indexnow:submit` can POST to prod instead of IndexNow directly:
# INDEXNOW_SUBMIT_URL=https://www.georgetownhomeservices.com
# (set INDEXNOW_SUBMIT_SECRET to match the server env when using this mode)
