# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/georgetown-home-services/

# Generated by next-sitemap after `npm run build` (when outDir is `public`)
/public/sitemap.xml
/public/sitemap-*.xml
/public/robots.txt

# next-sitemap IndexNow helper output (outDir in next-sitemap.config.js)
/.indexnow-tmp/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SEO pipeline reports (regenerated weekly by GitHub Actions; archived as workflow artifacts)
/.reports/
