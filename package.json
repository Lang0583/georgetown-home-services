{
  "name": "georgetown-home-services",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "browserslist": {
    "production": [
      "chrome >= 111",
      "edge >= 111",
      "firefox >= 111",
      "safari >= 16.4"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "generate:lead-pdfs": "tsx scripts/generate-lead-magnet-pdfs.ts",
    "generate:pdfs": "tsx scripts/generate-pdfs.ts",
    "prebuild": "node scripts/clean-legacy-sitemap.cjs && node scripts/write-indexnow-key.cjs && node scripts/write-impact-site-verification.cjs && npm run generate:lead-pdfs && npx tsx scripts/check-last-updated.ts",
    "build": "next build --webpack",
    "postbuild": "node scripts/clean-legacy-sitemap.cjs && node scripts/ensure-vercel-next-lock.cjs && npx tsx scripts/submit-indexnow.ts",
    "vercel-build": "npm run build",
    "indexnow": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/submit-indexnow.ts",
    "indexnow:submit": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/submit-indexnow.ts",
    "start": "next start",
    "lint": "eslint .",
    "smoke": "node scripts/smoke-check.mjs",
    "seo:pull": "tsx scripts/seo/pull-gsc-data.ts",
    "seo:audit": "tsx scripts/seo/audit-content-health.ts",
    "seo:freshness": "tsx scripts/seo/audit-freshness.ts",
    "seo:digest": "tsx scripts/seo/build-weekly-digest.ts",
    "seo:email": "tsx scripts/seo/email-digest.ts",
    "seo:propose": "tsx scripts/seo/propose-consolidation.ts",
    "seo:consolidate:patch": "tsx scripts/seo/apply-consolidation.ts",
    "seo:all": "npm run seo:pull && npm run seo:audit && npm run seo:freshness && npm run seo:digest",
    "seo:check": "npm run seo:audit && npm run seo:freshness",
    "submit-indexing-api": "ts-node scripts/submit-to-indexing-api.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@next/third-parties": "^16.2.3",
    "next": "16.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.11.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.1",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "jsdom": "^29.1.0",
    "next-sitemap": "^4.2.3",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^24.36.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
